{
    "task": [
        {
            "name": "DailyDungeon",
            "label": "日常副本",
            "entry": "Objectives.Daily.Dungeon1.Start",
            "description": "透過「筆記」進入日常副本進行挑戰。",
            "group": ["Note"],
            "controller": ["Android"]
        },
        {
            "name": "ArenaChallenge",
            "label": "競技場挑戰",
            "entry": "Objectives.Daily.Arena1.Start",
            "description": "筆記 → 競技；只處理第一個競技模式，在四個項目中選擇最右側的一個，戰鬥 3 次。",
            "group": ["Note"],
            "controller": ["Android"]
        },
        {
            "name": "BeastTrial",
            "label": "聖獸試煉",
            "entry": "Objectives.Daily.BeastTrialReward1.Start",
            "description": "筆記 → 每日活動 → 聖獸試煉 → 前往地圖 → 點人物上方入口 → 組隊 → 夥伴任選一人 → 進入副本。",
            "group": ["Note"],
            "controller": ["Android"]
        },
        {
            "name": "PhantomRealm",
            "label": "雙影幻境",
            "entry": "Objectives.Daily.PhantomRealmWave3.Start",
            "description": "筆記 → 每日活動 → 雙影幻境 → 前往地圖 → 點人物上方入口 → 組隊 → 夥伴任選一人 → 進入副本。",
            "group": ["Note"],
            "controller": ["Android"]
        },
        {
            "name": "MaterialRealm",
            "label": "素材秘境",
            "entry": "Objectives.MaterialRealm.Start",
            "description": "筆記 → 素材秘境；分別處理鐵石礦洞、黃金礦洞、怪物洞窟與砂石礦洞。四類均可獨立設定購買次數、快速開採及採集次數。購買預設為 0，避免意外消耗星形貨幣。",
            "group": ["Note"],
            "controller": ["Android"],
            "option": [
                "MaterialIronPurchaseCount",
                "MaterialIronQuickMining",
                "MaterialIronMiningCount",
                "MaterialGoldPurchaseCount",
                "MaterialGoldQuickMining",
                "MaterialGoldMiningCount",
                "MaterialMonsterPurchaseCount",
                "MaterialMonsterQuickMining",
                "MaterialMonsterMiningCount",
                "MaterialSandPurchaseCount",
                "MaterialSandQuickMining",
                "MaterialSandMiningCount"
            ]
        },
        {
            "name": "ExploreFate",
            "label": "探尋/探索命運",
            "entry": "Objectives.Pilgrimage.Daily.ExploreFate3.Start",
            "description": "「探尋命運」與「探索命運」是同一個遊戲功能，共用一個 Maa 任務。",
            "group": ["Map"],
            "controller": ["Android"]
        },
        {
            "name": "ConsumeStamina",
            "label": "消耗體力",
            "entry": "Objectives.ConsumeStamina.Start",
            "description": "由日常副本、素材秘境等已啟用流程自然消耗體力，不為湊進度使用付費道具。",
            "group": ["Map"],
            "controller": ["Android"]
        },
        {
            "name": "GuildRaid",
            "label": "公會討伐",
            "entry": "Objectives.Pilgrimage.Weekly.GuildRaid7.Start",
            "description": "進行公會討伐挑戰。",
            "group": ["Guild"],
            "controller": ["Android"]
        },
        {
            "name": "Commissions",
            "label": "委託任務",
            "entry": "Objectives.Commissions.Start",
            "description": "進行遊戲任務頁中的委託任務。",
            "group": ["Other"],
            "controller": ["Android"]
        },
        {
            "name": "BondAdventureScenicDispatch",
            "label": "羈絆冒險／奇景委派",
            "entry": "Objectives.BondAdventureScenicDispatch.Start",
            "description": "「羈絆冒險」與「奇景委派」是同一個遊戲功能，從筆記的羈絆冒險入口進入。",
            "group": ["Note"],
            "controller": ["Android"]
        },
        {
            "name": "GoddessStatuePrayer",
            "label": "女神像祈願",
            "entry": "Objectives.GoddessStatue.Prayer.Start",
            "description": "至家園女神像選擇「祈願」->「友情祈願」，點擊祈願 1 次（執行 2 次）。",
            "group": ["Home"],
            "controller": ["Android"]
        },
        {
            "name": "TimeGachaMachine",
            "label": "時光扭蛋機",
            "entry": "Objectives.GachaMachine.Start",
            "description": "至家園扭蛋台選擇「國度」，點擊扭蛋 1 次（執行 2 次）。",
            "group": ["Home"],
            "controller": ["Android"]
        },
        {
            "name": "SakuraBeastBonding",
            "label": "幻獸結緣",
            "entry": "Objectives.SakuraTree.BeastBonding.Start",
            "description": "點擊家園大櫻花樹（嘗試多次進入），選擇「結緣十次」。",
            "group": ["Home"],
            "controller": ["Android"]
        },
        {
            "name": "GuildDonation",
            "label": "公會捐贈",
            "entry": "Objectives.Guild.Donation.Start",
            "description": "至公會大廳執行捐贈；每日最多 5 次，第 1 次免費，後續允許消耗遊戲資源，依設定次數停止。",
            "group": ["Guild"],
            "controller": ["Android"],
            "option": ["GuildDonationCount"]
        },
        {
            "name": "GuildIdleReward",
            "label": "公會放置獎勵",
            "entry": "Objectives.Guild.IdleReward.Start",
            "description": "點擊公會右下角的放置獎勵爐子領取收益。",
            "group": ["Guild"],
            "controller": ["Android"]
        },
        {
            "name": "AlchemyFurnace",
            "label": "煉金爐分解裝備與寶石合成",
            "entry": "Objectives.AlchemyFurnace.Start",
            "description": "至家園右側煉金鍋爐：依設定決定是否勾選排除高戰力，再分解所選裝備；寶石頁執行一鍵合成。",
            "group": ["Home"],
            "controller": ["Android"],
            "option": ["AlchemyExcludeHighPower"]
        },
        {
            "name": "BagUseItems",
            "label": "背包道具一鍵使用",
            "entry": "Objectives.Bag.UseItems.Start",
            "description": "點擊家園寶箱，選擇右下角一鍵使用道具。",
            "group": ["Home"],
            "controller": ["Android"]
        }
    ],
    "option": {
        "MaterialIronPurchaseCount": {
            "type": "input",
            "label": "鐵石礦洞：購買次數",
            "description": "每日購買鐵礦錘的次數，範圍 0～20；會消耗畫面顯示的星形貨幣，預設 0。",
            "inputs": [
                {
                    "name": "Count",
                    "label": "次數",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(?:[0-9]|1[0-9]|20)$",
                    "pattern_msg": "請輸入 0～20。"
                }
            ],
            "pipeline_override": {"MaterialRealm.Iron.Purchase.Open": {"max_hit": "{Count}"}}
        },
        "MaterialIronQuickMining": {
            "type": "switch",
            "label": "鐵石礦洞：快速開採",
            "description": "是否將鐵石礦洞的快速開採切換為開啟。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "開啟",
                    "pipeline_override": {
                        "MaterialRealm.Iron.Quick.Route": {
                            "next": [
                                "MaterialRealm.Iron.Quick.On",
                                "MaterialRealm.Iron.Quick.Enable"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "關閉",
                    "pipeline_override": {
                        "MaterialRealm.Iron.Quick.Route": {
                            "next": [
                                "MaterialRealm.Iron.Quick.Off",
                                "MaterialRealm.Iron.Quick.Disable"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "MaterialIronMiningCount": {
            "type": "input",
            "label": "鐵石礦洞：採集次數",
            "description": "鐵石礦洞要執行的採集次數，範圍 0～999。",
            "inputs": [
                {
                    "name": "Count",
                    "label": "次數",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(?:0|[1-9][0-9]{0,2})$",
                    "pattern_msg": "請輸入 0～999。"
                }
            ],
            "pipeline_override": {"MaterialRealm.Iron.Mine": {"max_hit": "{Count}"}}
        },
        "MaterialGoldPurchaseCount": {
            "type": "input",
            "label": "黃金礦洞：購買次數",
            "description": "每日購買黃金礦洞採集道具的次數，範圍 0～20；預設 0。",
            "inputs": [
                {
                    "name": "Count",
                    "label": "次數",
                    "default": "0",
