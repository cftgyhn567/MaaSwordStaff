        "GuildDonationCount": {
            "type": "select",
            "label": "每日公會捐贈次數",
            "description": "每天最多執行幾次公會捐贈；第 1 次免費，後續允許消耗遊戲資源。畫面上限為 5 次，0 代表不執行。",
            "cases": [
                {
                    "name": "Donate0",
                    "label": "0 次（不捐贈）",
                    "pipeline_override": {"Guild.Donation.Execute": {"max_hit": 0}}
                },
                {
                    "name": "Donate1",
                    "label": "1 次",
                    "pipeline_override": {"Guild.Donation.Execute": {"max_hit": 1}}
                },
                {
                    "name": "Donate2",
                    "label": "2 次",
