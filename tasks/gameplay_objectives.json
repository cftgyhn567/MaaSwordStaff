                    "pattern_msg": "請輸入 0～20。"
                }
            ],
            "pipeline_override": {"MaterialRealm.Gold.Purchase.Open": {"max_hit": "{Count}"}}
        },
        "MaterialGoldQuickMining": {
            "type": "switch",
