    "option": {
        "GuildDonationCount": {
            "type": "input",
            "label": "$text.234",
            "description": "$text.235",
            "inputs": [
                {
                    "name": "Count",
                    "label": "$text.075",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[0-5]$",
                    "pattern_msg": "請輸入 0～5。"
                }
            ],
            "pipeline_override": {
                "GuildDonation.Pull.Deduct": {
                    "custom_action_param": {
                        "profile": "guild_donation",
                        "total": "{Count}",
                        "deduct_done": true
                    }
                },
                "GuildDonation.Pull.Raw": {
                    "custom_action_param": {
                        "profile": "guild_donation",
                        "total": "{Count}",
                        "deduct_done": false
                    }
                }
            }
        },
        "GuildDonationDeduct": {
            "type": "switch",
            "label": "$text.236",
            "description": "$text.237",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$text.123",
                    "pipeline_override": {
                        "GuildDonation.Pull.Route": {
                            "next": [
                                "GuildDonation.Pull.Deduct"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$text.124",
                    "pipeline_override": {
                        "GuildDonation.Pull.Route": {
                            "next": [
                                "GuildDonation.Pull.Raw"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "GuildRaidCount": {
            "type": "select",
            "label": "$text.238",
            "description": "$text.239",
            "cases": [
                {
                    "name": "Count0",
                    "label": "$text.178",
                    "pipeline_override": {
                        "GuildRaid.RaidScreen": {
                            "next": [
                                "GuildRaid.NoMore"
                            ]
                        }
                    }
                },
                {
                    "name": "Count1",
                    "label": "$text.179",
                    "pipeline_override": {
                        "GuildRaid.RaidScreen": {
                            "next": [
                                "GuildRaid.Loop.Challenge",
                                "GuildRaid.NoMore"
                            ]
                        },
                        "GuildRaid.Loop.Challenge": {
                            "max_hit": 1
                        }
                    }
                },
                {
                    "name": "Count2",
                    "label": "$text.180",
