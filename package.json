{
    "devDependencies": {
        "@nekosu/maa-tools": "1.0.24",
        "@nekosu/prettier-plugin-maafw-sort": "1.0.5",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "jsonc-parser": "3.3.1",
        "prettier": "3.9.5",
        "prettier-plugin-multiline-arrays": "4.1.10"
    },
    "engines": {
        "node": ">=24"
    },
    "license": "MIT",
    "name": "maa-sword-staff",
    "packageManager": "pnpm@11.5.1",
    "private": true,
    "scripts": {
        "audit:pipeline": "node tools/audit-pipeline.mjs",
        "build:mxu": "node tools/build-custom-mxu.mjs",
        "check": "pnpm format:check && pnpm check:schema && pnpm check:maa",
        "check:maa": "pnpm exec maa-tools check",
        "check:py": "python -m py_compile agent/bootstrap.py agent/main.py",
        "check:schema": "node tools/validate-schema.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "release:dry-run": "node tools/build-release.mjs --dry-run",
        "sync:runtime": "node tools/sync-runtime.mjs"
    },
    "type": "module",
    "version": "1.0.4"
}
