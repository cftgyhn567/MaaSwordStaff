+/// 获取 GitHub 最新的稳定 Release
+///
+/// 用于没有配置 MirrorChyan RID、仅通过 GitHub Releases 更新的项目。
+#[tauri::command]
+pub async fn get_github_latest_release(
+    owner: String,
+    repo: String,
+    github_pat: Option<String>,
+    proxy_url: Option<String>,
+) -> Result<GitHubRelease, String> {
+    let url = format!(
+        "https://api.github.com/repos/{}/{}/releases/latest",
+        owner, repo
+    );
+    let release: GitHubRelease = fetch_github_release(&url, github_pat, proxy_url).await?;
+    info!(
+        "获取到 GitHub 最新 Release: {} (tag: {})",
+        release.name, release.tag_name
+    );
+    Ok(release)
+}
