diff --git a/src/services/updateService.ts b/src/services/updateService.ts
index 473da55..5feaff2 100644
--- a/src/services/updateService.ts
+++ b/src/services/updateService.ts
@@ -513,0 +514,23 @@ async function getGitHubReleaseByVersion(
+/**
+ * 获取 GitHub 最新的稳定 Release
+ * GitHub 的 releases/latest 接口会自动排除草稿和预发布版本。
+ */
+async function getGitHubLatestRelease(
+  owner: string,
+  repo: string,
+  githubPat?: string,
+  proxyUrl?: string,
+): Promise<GitHubRelease | null> {
+  try {
+    return await invoke<GitHubRelease>('get_github_latest_release', {
+      owner,
+      repo,
+      githubPat,
+      proxyUrl,
+    });
+  } catch (error) {
+    log.error('获取 GitHub 最新 Release 失败:', error);
+    return null;
+  }
+}
+
@@ -862,0 +886,45 @@ export interface CheckAndDownloadOptions extends CheckUpdateOptions {
+async function checkGitHubUpdate(options: CheckAndDownloadOptions): Promise<UpdateInfo | null> {
+  const { githubUrl, githubPat, proxyUrl, currentVersion } = options;
+  if (!githubUrl) {
+    log.warn('未配置 mirrorchyan_rid 或 github，跳过更新检查');
+    return null;
+  }
+
+  const parsed = parseGitHubUrl(githubUrl);
+  if (!parsed) {
+    log.warn('无法解析 GitHub URL:', githubUrl);
+    return null;
+  }
+
+  const release = await getGitHubLatestRelease(parsed.owner, parsed.repo, githubPat, proxyUrl);
+  if (!release) return null;
+
+  const hasUpdate = compareVersions(release.tag_name, currentVersion) > 0;
+  const updateInfo: UpdateInfo = {
+    hasUpdate,
+    versionName: release.tag_name,
+    releaseNote: release.body || '',
+    channel: 'stable',
+  };
+
+  if (!hasUpdate) {
+    log.info(`当前已是最新版本: ${currentVersion}`);
+    return updateInfo;
+  }
+
+  const asset = await matchGitHubAsset(release.assets);
+  if (!asset) {
+    log.warn('GitHub 最新 Release 中未找到匹配当前系统和架构的文件');
+    return updateInfo;
+  }
+
+  log.info(`GitHub-only 更新可用: ${release.tag_name} (${asset.name})`);
+  return {
+    ...updateInfo,
+    downloadUrl: asset.browser_download_url,
+    fileSize: asset.size,
+    filename: asset.name,
+    downloadSource: 'github',
+  };
+}
+
